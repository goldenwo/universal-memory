{
  "name": "universal-memory-server",
  "version": "1.16.0",
  "description": "Memory server for universal-memory — wraps mem0 OSS, exposes REST + MCP HTTP endpoints",
  "type": "module",
  "private": true,
  "main": "mem0-mcp-http.mjs",
  "scripts": {
    "start": "node mem0-mcp-http.mjs",
    "test": "node --test test/*.test.mjs test/*/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@google/genai": "2.17.1",
    "@qdrant/js-client-rest": "1.18.0",
    "better-sqlite3": "^12.9.0",
    "mem0ai": "3.1.6",
    "ollama": "0.5.18",
    "openai": "^7.5.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "uuid": "9.0.1",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "mem0ai": {
      "@anthropic-ai/sdk": "$@anthropic-ai/sdk",
      "@google/genai": "$@google/genai"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@apidevtools/swagger-parser": "^12.1.0",
    "patch-package": "^8.0.1",
    "tiktoken": "^1.0.0"
  }
}
