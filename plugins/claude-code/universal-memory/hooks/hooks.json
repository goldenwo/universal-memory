{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "commandWindows": "cmd /d /c \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start.sh",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh\"",
            "commandWindows": "cmd /d /c \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" user-prompt-submit.sh",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh\"",
            "commandWindows": "cmd /d /c \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" stop.sh",
            "async": false,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh\"",
            "commandWindows": "cmd /d /c \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-end.sh",
            "async": false
          }
        ]
      }
    ]
  }
}
