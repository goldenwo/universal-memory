# Shell scripts must be LF on all platforms — CRLF breaks bash on Linux/macOS.
# This prevents the failure seen when stop.sh / continuity.sh chain to a
# CRLF-stored script and the Linux CI runner reports:
#   $'\r': command not found
*.sh text eol=lf

# Plugin launcher scripts under plugins/**/bin/ have no .sh extension but are
# bash scripts — force LF explicitly so they stay executable on Linux/macOS.
plugins/**/bin/um text eol=lf
plugins/**/bin/um-* text eol=lf
plugins/**/hooks/* text eol=lf

# Test fixtures must be byte-stable across platforms — token-cost.test.mjs
# and similar tokenizer-based tests depend on exact byte counts. CRLF on
# Windows inflates counts vs the LF form that CI runs against, producing
# platform-dependent baseline drift.
server/test/fixtures/* text eol=lf
server/test/token-cost-baseline.txt text eol=lf
# Exception: SQLite DB fixtures are binary — LF-normalization would corrupt them.
server/test/fixtures/*.db binary

# server/patches/ reconciliation artifacts must be byte-exact LF: patch-package
# applies *.patch on Alpine (CRLF breaks hunk matching) and the Dockerfile +
# deps-guard compare *.source.sha256 content with `[ "$computed" = "$expected" ]`
# (a trailing \r fails the string compare). Both committed files are already LF
# (verified), so this is a no-op pin on today's tree, not a renormalization —
# it protects the Windows-authored re-derivation in the #231 mem0ai 3.x arc.
server/patches/*.patch text eol=lf
server/patches/*.source.sha256 text eol=lf

# NOT pinned: `*.mjs text eol=lf`. It was added in #218 on the claim that every
# .mjs was already LF so the rule was a no-op. That claim was wrong — FOUR files
# are committed with CRLF bytes (server/lib/ranking.mjs, server/openapi.mjs,
# server/test/custom-gpt-actions.test.mjs, server/test/frontmatter.test.mjs), so
# the rule made a fresh clone or worktree show ~2,000 lines of pure line-ending
# churn across them, one of which was under active edit on another branch. A
# `git add -A` there would have swept the renormalization into an unrelated
# commit.
#
# Pinning JS to LF is still worth doing, but it has to be a DELIBERATE
# renormalization (rule + `git add --renormalize .` in one commit, on a quiet
# tree), not a rule dropped on top of a tree that does not already satisfy it.
# cf. f2c178f, which reverted an out-of-scope line-ending normalization for the
# same reason.
